<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root_compact"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="#1C1F26">

    <!-- Top Section: Logo & Stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <ImageView
            android:id="@+id/iv_focused_logo_compact"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_apps_today_header_compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apps today"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_summary_stats_compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3h 24m screen time • 64 app opens"
                android:textColor="#A0A4AF"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row of Top Apps Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Chip 1 -->
        <LinearLayout
            android:id="@+id/chip_app_1_compact"
            android:layout_width="wrap_content"
            android:layout_height="27dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/notif_chip_bg"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_app_1_compact"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="4dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tv_app_1_compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3h 24m"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Chip 2 -->
        <LinearLayout
            android:id="@+id/chip_app_2_compact"
            android:layout_width="wrap_content"
            android:layout_height="27dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/notif_chip_bg"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_app_2_compact"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="4dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tv_app_2_compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2h 13m"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Chip 3 -->
        <LinearLayout
            android:id="@+id/chip_app_3_compact"
            android:layout_width="wrap_content"
            android:layout_height="27dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/notif_chip_bg"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_app_3_compact"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="4dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tv_app_3_compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="46m"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="9dp"
    android:paddingBottom="10dp"
    android:background="#1C1F26">

    <!-- Header Row: App Logo + Title & Summary Stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <!-- App Branding Icon -->
        <ImageView
            android:id="@+id/iv_focused_logo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="12dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="fitCenter" />

        <!-- Title & Subtitle with Total Usage & Opens -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_apps_today_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apps today"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_summary_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3h 24m screen time • 64 app opens"
                android:textColor="#A0A4AF"
                android:textSize="12sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top 6 Apps Grid: Row 1 (Apps 1, 2, 3) -->
    <LinearLayout
        android:id="@+id/layout_apps_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <!-- Chip 1 -->
        <LinearLayout
            android:id="@+id/chip_app_1"
            android:layout_width="wrap_content"
            android:layout_height="29dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/notif_chip_bg"
            android:paddingStart="5dp"
            android:paddingEnd="9dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_app_1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="5dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tv_app_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3h 24m"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Chip 2 -->
        <LinearLayout
            android:id="@+id/chip_app_2"
            android:layout_width="wrap_content"
            android:layout_height="29dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/notif_chip_bg"
            android:paddingStart="5dp"
            android:paddingEnd="9dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_app_2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="5dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tv_app_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2h 13m"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Chip 3 -->
        <LinearLayout
            android:id="@+id/chip_app_3"
            android:layout_width="wrap_content"
            android:layout_height="29dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/notif_chip_bg"
            android:paddingStart="5dp"
            android:paddingEnd="9dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_app_3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="5dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tv_app_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="46m"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top 6 Apps Grid: Row 2 (Apps 4, 5, 6) -->
    <LinearLayout
        android:id="@+id/layout_apps_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Chip 4 -->
        <LinearLayout
            android:id="@+id/chip_app_4"
            android:layout_width="wrap_content"
            android:layout_height="29dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/notif_chip_bg"
            android:paddingStart="5dp"
            android:paddingEnd="9dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_app_4"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="5dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tv_app_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25m"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Chip 5 -->
        <LinearLayout
            android:id="@+id/chip_app_5"
            android:layout_width="wrap_content"
            android:layout_height="29dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/notif_chip_bg"
            android:paddingStart="5dp"
            android:paddingEnd="9dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_app_5"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="5dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tv_app_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18m"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Chip 6 -->
        <LinearLayout
            android:id="@+id/chip_app_6"
            android:layout_width="wrap_content"
            android:layout_height="29dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/notif_chip_bg"
            android:paddingStart="5dp"
            android:paddingEnd="9dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_app_6"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="5dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tv_app_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8m"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

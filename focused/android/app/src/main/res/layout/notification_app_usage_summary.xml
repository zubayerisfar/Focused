<?xml version="1.0" encoding="utf-8"?>
<!--
  Focused Daily App Summary Notification – Expanded View
  Shows header stats + top 6 apps as icon + name + usage rows
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="14dp">

    <!-- ══════════ HEADER ══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/iv_focused_logo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_apps_today_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Day in Apps"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_summary_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3h 24m screen time · 64 opens"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══════════ APP ROW 1 ══════════ -->
    <LinearLayout
        android:id="@+id/chip_app_1"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_app_1"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tv_app_1_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="YouTube"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_app_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1h 22m"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ══════════ APP ROW 2 ══════════ -->
    <LinearLayout
        android:id="@+id/chip_app_2"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_app_2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tv_app_2_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Instagram"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_app_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="48m"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ══════════ APP ROW 3 ══════════ -->
    <LinearLayout
        android:id="@+id/chip_app_3"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_app_3"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tv_app_3_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chrome"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_app_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="31m"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ══════════ APP ROW 4 ══════════ -->
    <LinearLayout
        android:id="@+id/chip_app_4"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_app_4"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tv_app_4_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TikTok"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_app_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="22m"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ══════════ APP ROW 5 ══════════ -->
    <LinearLayout
        android:id="@+id/chip_app_5"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_app_5"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tv_app_5_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="WhatsApp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_app_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14m"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ══════════ APP ROW 6 ══════════ -->
    <LinearLayout
        android:id="@+id/chip_app_6"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_app_6"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tv_app_6_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Maps"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_app_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8m"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
